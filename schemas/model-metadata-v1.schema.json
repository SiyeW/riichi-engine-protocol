{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riichi-engine-protocol:schema:model-metadata:v1",
  "title": "Riichi Engine Protocol Model Metadata v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "engineId",
    "format",
    "file",
    "sha256",
    "sizeBytes",
    "inputSchema",
    "outputSchema"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engineId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "format": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "file": {
      "$ref": "#/$defs/relativePath"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "inputSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "outputSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "opponentInputModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "public"
      },
      "items": {
        "enum": ["public", "full-information"]
      }
    },
    "training": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "source": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "additionalProperties": true
    },
    "license": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
