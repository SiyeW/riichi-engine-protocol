{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riichi-engine-protocol:schema:decision:v1",
  "title": "Decision Engine Result v1",
  "type": "object",
  "required": [
    "sessionId",
    "positionId",
    "historyDigest",
    "engineFingerprint",
    "bestCandidateId",
    "choices"
  ],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "positionId": { "type": "string" },
    "historyDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "engineFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bestCandidateId": { "type": "string", "minLength": 1 },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidateId", "rawValue", "probability"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "scoreGroupId": { "type": "string", "minLength": 1 },
          "rawValue": { "type": "number" },
          "probability": { "$ref": "#/$defs/probability" }
        }
      }
    },
    "timing": { "$ref": "#/$defs/timing" }
  },
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timing": {
      "type": "object",
      "properties": {
        "preprocessMs": { "type": "number", "minimum": 0 },
        "queueMs": { "type": "number", "minimum": 0 },
        "inferenceMs": { "type": "number", "minimum": 0 },
        "totalMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
